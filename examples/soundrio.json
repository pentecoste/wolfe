{
  // Microphone with noise suppression, plus the Soundrio soundboard, sent to
  // the people you talk to. The suppression is applied to the microphone
  // only, before the soundboard is mixed in.
  //
  // In Windows' settings (Settings > System > Sound > Volume mixer) have
  // Soundrio play on "Wolfe Soundboard". In Mumble, Discord or wherever
  // friends should hear this, choose "Wolfe Chat" as the microphone and turn
  // off that program's own noise suppression: it would treat the soundboard
  // as noise. You hear the soundboard on your default playback device.
  "nodes": [
    { "id": "soundboard", "type": "virtual_speaker", "name": "Wolfe Soundboard" },
    { "id": "chat",       "type": "virtual_mic",     "name": "Wolfe Chat" },
    { "id": "mic",        "type": "input",           "device": "Razer Seiren Mini" },
    { "id": "denoise",    "type": "rnnoise" },
    { "id": "phones",     "type": "output",          "device": "default" }
  ],
  "links": [
    { "from": "mic",        "to": "denoise" },
    { "from": "denoise",    "to": "chat" },
    { "from": "soundboard", "to": "chat" },
    { "from": "soundboard", "to": "phones" }
  ]
}
